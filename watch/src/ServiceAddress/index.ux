<template>
  <div class="page">
    <div class="header"><text class="back" onclick="back">取消</text><text class="title">配套服务地址</text><text class="done" onclick="done">保存</text></div>
    <text class="value">{{value}}</text>
    <div class="keys" for="{{row in rows}}"><text class="key" for="{{key in row.keys}}" onclick="tap(key)">{{key}}</text></div>
    <div class="controls"><text class="control" onclick="toggle">字母/数字</text><text class="control" onclick="slash">/</text><text class="control" onclick="erase">退格</text></div>
    <text class="hint">{{hint}}</text>
  </div>
</template>
<script>
import router from '@system.router'
const sync=require('../lib/sync')
export default {
  private:{value:'https://',rows:[],numeric:false,hint:'填写配套网页所在的地址，不是模型 API。'},
  onInit(){this.value=this.$app.$def.sync.baseUrl || 'https://';this.keys()},
  keys(){this.rows=(this.numeric?['1234567890','.:/-_','']:['qwertyuiop','asdfghjkl','zxcvbnm.-']).map(row=>({keys:row.split('')}))},
  tap(key){if(this.value.length<180)this.value+=key},toggle(){this.numeric=!this.numeric;this.keys()},slash(){this.tap('/')},erase(){this.value=this.value.slice(0,-1)},
  done(){
    let base;try{base=sync.normalizeBase(this.value)}catch(e){this.hint='请输入有效 HTTPS 地址；局域网地址可用 HTTP。';return}
    const app=this.$app.$def
    if(base!==app.sync.baseUrl)app.sync={baseUrl:base,id:'',deviceToken:'',editorToken:''}
    app.save();router.back()
  },back(){router.back()}
}
</script>
<style>
.page {width:100%;height:100%;padding:42px 16px 18px;background-color:#142331;flex-direction:column;}
.header {height:44px;padding:0px 12px;justify-content:space-between;align-items:center;}
.back,.done {font-size:22px;color:#c8ded0;width:60px;height:44px;text-align:center;}
.title {font-size:24px;color:#fff4dd;}
.value {height:100px;padding:10px;margin:10px 0px;background-color:#273e43;color:#fff4dd;font-size:22px;border-radius:12px;max-lines:3;}
.keys {height:54px;justify-content:center;}
.key {flex:1;height:48px;margin:2px;background-color:#2c4446;color:#fff4dd;font-size:25px;text-align:center;border-radius:8px;}
.controls {height:52px;justify-content:space-between;margin-top:6px;}
.control {width:126px;height:48px;background-color:#2c4446;color:#fff4dd;font-size:21px;text-align:center;border-radius:10px;}
.hint {font-size:18px;color:#c0d0c9;margin-top:14px;max-lines:3;}
</style>
