# 此文件复制为 .env 后填写，不要把 .env 发到聊天或提交到仓库。
HOST=127.0.0.1
PORT=8787
# 自选 Chat Completions 兼容服务。填写 /v1 等基础路径，不包括 /chat/completions。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 自己生成一段随机字符串，与 watch/src/config.js 中的 deviceToken 一致。
WATCH_TOKEN=
AI_TIMEOUT_MS=20000

# DeepSeek Flash 可选：禁用思考模式以缩短手表回复等待；其他兼容服务不支持时留空。
AI_THINKING=
